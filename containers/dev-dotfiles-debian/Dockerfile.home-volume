# syntax=docker/dockerfile:1.7
# Optional local experiment based on an existing image. The primary Dockerfile
# now also publishes the home-seed layout, without requiring this wrapper.
ARG BASE_IMAGE=ghcr.io/arran4/dev-dotfiles-debian:latest
FROM ${BASE_IMAGE}

ARG USER_NAME=user
# Set to a release/tag or commit when building a local experiment. The
# archive digest also changes the version when the baked home contents change.
ARG IMAGE_VERSION=development

USER root

# Snapshot only the image's prepared home, outside the runtime home mount.
# This wrapper is intended for older base images that still have a baked home;
# do not wrap an already seeded published image (its baked home is empty).
RUN set -eu; \
  home=$(getent passwd "$USER_NAME" | cut -d: -f6); \
  test -d "$home"; \
  test -n "$(ls -A "$home")"; \
  test ! -L /workspace; \
  install -d -o "$(id -u "$USER_NAME")" -g "$(id -g "$USER_NAME")" /workspace; \
  install -d -m 0755 /usr/local/share/dev-dotfiles-debian; \
  if [ -d "$home/workspace" ] && [ ! -L "$home/workspace" ] && [ -z "$(ls -A "$home/workspace")" ]; then rmdir "$home/workspace"; fi; \
  if [ ! -e "$home/workspace" ] && [ ! -L "$home/workspace" ]; then ln -s /workspace "$home/workspace"; fi; \
  tar -C "$home" -cf /usr/local/share/dev-dotfiles-debian/home-seed.tar .; \
  digest=$(sha256sum /usr/local/share/dev-dotfiles-debian/home-seed.tar | cut -d ' ' -f 1); \
  printf '%s:%s\n' "$IMAGE_VERSION" "$digest" > /usr/local/share/dev-dotfiles-debian/home-seed-version; \
  find "$home" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +

COPY --chmod=0755 containers/dev-dotfiles-debian/home-volume-seed.sh /usr/local/bin/dev-dotfiles-home-seed
COPY --chmod=0755 containers/dev-dotfiles-debian/home-volume-entrypoint.sh /usr/local/bin/dev-dotfiles-home-entrypoint

ENV DEV_HOME_SEED_ARCHIVE=/usr/local/share/dev-dotfiles-debian/home-seed.tar \
  DEV_HOME_SEED_VERSION_FILE=/usr/local/share/dev-dotfiles-debian/home-seed-version
LABEL io.github.arran4.dev-dotfiles.home-seed="1"

USER ${USER_NAME}
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/dev-dotfiles-home-entrypoint"]
