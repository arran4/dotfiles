#!/bin/sh
set -eu

dst="$HOME/.config/konsolequickcommandsconfig"
mkdir -p "$(dirname "$dst")"

tmp="$(mktemp "${dst}.tmp.XXXXXX")"
trap 'rm -f "$tmp"' EXIT HUP INT TERM

cat >"$tmp" <<'EOF'
{{ template "konsolequickcommandsconfig.tmpl" . }}
EOF

if [ -f "$dst" ] && cmp -s "$tmp" "$dst"; then
  exit 0
fi

if command -v pgrep >/dev/null 2>&1 && pgrep -x konsole >/dev/null 2>&1; then
  printf '%s\n' "chezmoi: Konsole is running; deferring Quick Commands update until the next apply." >&2
  exit 0
fi

chmod 644 "$tmp"
mv -f "$tmp" "$dst"
trap - EXIT HUP INT TERM
