-- Modern Wayland/GPU terminals -> desktop terminals -> urxvt -> xterm (final fallback).
local candidateTerminals = {
{{- if ne (index . "ghosttyLocation" | default "") "" }}
    { name = "ghostty", path = [=[{{.ghosttyLocation}}]=] },
{{- end }}
{{- if ne (index . "footLocation" | default "") "" }}
    { name = "foot", path = [=[{{.footLocation}}]=] },
{{- end }}
{{- if ne (index . "kittyLocation" | default "") "" }}
    { name = "kitty", path = [=[{{.kittyLocation}}]=] },
{{- end }}
{{- if ne (index . "alacrittyLocation" | default "") "" }}
    { name = "alacritty", path = [=[{{.alacrittyLocation}}]=] },
{{- end }}
{{- if ne (index . "weztermLocation" | default "") "" }}
    { name = "wezterm", path = [=[{{.weztermLocation}}]=] },
{{- end }}
{{- if ne (index . "terminatorLocation" | default "") "" }}
    { name = "terminator", path = [=[{{.terminatorLocation}}]=] },
{{- end }}
{{- if ne (index . "konsoleLocation" | default "") "" }}
    { name = "konsole", path = [=[{{.konsoleLocation}}]=] },
{{- end }}
{{- if ne (index . "xfce4TerminalLocation" | default "") "" }}
    { name = "xfce4-terminal", path = [=[{{.xfce4TerminalLocation}}]=] },
{{- end }}
{{- if ne (index . "gnomeTerminalLocation" | default "") "" }}
    { name = "gnome-terminal", path = [=[{{.gnomeTerminalLocation}}]=] },
{{- end }}
{{- if ne (index . "mateTerminalLocation" | default "") "" }}
    { name = "mate-terminal", path = [=[{{.mateTerminalLocation}}]=] },
{{- end }}
{{- if ne (index . "lxterminalLocation" | default "") "" }}
    { name = "lxterminal", path = [=[{{.lxterminalLocation}}]=] },
{{- end }}
{{- if ne (index . "urxvtLocation" | default "") "" }}
    { name = "urxvt", path = [=[{{.urxvtLocation}}]=] },
{{- end }}
{{- if ne (index . "xtermLocation" | default "") "" }}
    { name = "xterm", path = [=[{{.xtermLocation}}]=] },
{{- end }}
}

-- Fallback terminal names for runtime PATH search in Lua:
-- urxvt and xterm are the final two fallbacks (urxvt preferred over xterm).
local runtimeFallbackTerminals = {
    "ghostty",
    "foot",
    "kitty",
    "alacritty",
    "wezterm",
    "terminator",
    "konsole",
    "xfce4-terminal",
    "gnome-terminal",
    "mate-terminal",
    "lxterminal",
    "urxvt",
    "xterm",
}

local function isExecutable(path)
    if not path or path == "" then
        return false
    end
    local f = io.open(path, "r")
    if f then
        f:close()
        return true
    end
    return false
end

local function findInPath(cmd)
    if not cmd or cmd == "" then
        return nil
    end
    if cmd:sub(1, 1) == "/" then
        if isExecutable(cmd) then
            return cmd
        end
        return nil
    end
    local pathEnv = os.getenv("PATH") or "/usr/local/bin:/usr/bin:/bin"
    for dir in pathEnv:gmatch("[^:]+") do
        local fullPath = dir .. "/" .. cmd
        if isExecutable(fullPath) then
            return fullPath
        end
    end
    return nil
end

local function resolveTerminal()
    for _, candidate in ipairs(candidateTerminals) do
        if candidate.path and candidate.path ~= "" then
            if candidate.path:sub(1, 1) == "/" then
                if isExecutable(candidate.path) then
                    return candidate.path
                end
            else
                local found = findInPath(candidate.path)
                if found then
                    return found
                end
            end
        end
    end
    for _, name in ipairs(runtimeFallbackTerminals) do
        local found = findInPath(name)
        if found then
            return found
        end
    end
    return ""
end

local terminal = resolveTerminal()
local popupTerm = terminal
local launcher = [=[{{$launcher}}]=]
local lockcmd = [=[{{$lockcmd}}]=]
local clipse = [=[{{$clipse}}]=]
local playerctlPlayer = [=[{{$playerctlPlayer}}]=]

