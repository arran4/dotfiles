    hl.bind("SUPER + CTRL + Print", hl.dsp.exec_cmd([=[hyprshot -m window -o "$HOME/Pictures/Screenshots"]=]))
  {{- else }}
    hl.bind("SUPER + Print", hl.dsp.exec_cmd([=[grim -g "$(slurp -w)" - | tee "$HOME/Pictures/Screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png" | wl-copy]=]))
    hl.bind("SHIFT + Print", hl.dsp.exec_cmd([=[grim - | tee "$HOME/Pictures/Screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png" | wl-copy]=]))
    hl.bind("SUPER + SHIFT + Print", hl.dsp.exec_cmd([=[grim -g "$(slurp)" - | tee "$HOME/Pictures/Screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png" | wl-copy]=]))
    hl.bind("SUPER + CTRL + Print", hl.dsp.exec_cmd([=[grim -g "$(slurp -w)" - | tee "$HOME/Pictures/Screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png" | wl-copy]=]))
  {{- end }}
{{- end }}

    hl.bind("SUPER + F5", hl.dsp.exec_cmd("set-wallpaper"))

{{- if ne .hyprland_features "quickshell" }}
    if lockcmd ~= "" then
        hl.bind("SUPER + L", hl.dsp.exec_cmd(lockcmd))
    end
{{- end }}

    -- Media keys.
    hl.bind("XF86AudioRaiseVolume", hl.dsp.exec_cmd("wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 1%+"), { repeating = true })
    hl.bind("XF86AudioLowerVolume", hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-"), { locked = true })
    hl.bind("XF86AudioMute", hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"), { locked = true })
    hl.bind("SUPER + SHIFT + M", hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"), { locked = true })
{{- if ne .hyprland_features "quickshell" }}
    -- Caelestia owns playback transport keys in quickshell mode. Register the
    -- playerctl fallback only when Caelestia is not providing those bindings.
    hl.bind("XF86AudioPlay", hl.dsp.exec_cmd("playerctl --player=" .. playerctlPlayer .. " play-pause"), { locked = true })
    hl.bind("XF86AudioPrev", hl.dsp.exec_cmd("playerctl --player=" .. playerctlPlayer .. " previous"), { locked = true })
    hl.bind("XF86AudioNext", hl.dsp.exec_cmd("playerctl --player=" .. playerctlPlayer .. " next"), { locked = true })
{{- end }}

    -- Mouse bindings.
    hl.bind("SUPER + mouse:272", hl.dsp.window.drag(), { mouse = true })
    hl.bind("SUPER + mouse:273", hl.dsp.window.resize(), { mouse = true })
end

registerBinds()

-- ------------------------
-- Workspace rules
-- ------------------------
for _, workspace in ipairs({
    "1", "2", "3", "4", "5", "6", "7", "8", "9",
}) do
    hl.workspace_rule({ workspace = workspace, persistent = true })
end

-- ------------------------
-- Window rules
-- ------------------------
hl.window_rule({
    match = { class = "^(XTerm|xterm)$" },
    opacity = "0.82 override 0.82 override 1.0 override",
})
hl.window_rule({
    match = { class = "^(zenity|kdialog)$" },
    center = true,
    float = true,
})
hl.window_rule({
    match = { title = "Picture(-| )in(-| )[Pp]icture" },
    move = "(monitor_w*0.98-window_w) (monitor_h*0.97-window_h)",
    pin = true,
    float = true,
    keep_aspect_ratio = true,
})

-- ------------------------
-- Autostart
-- ------------------------
local function startCliphistDaemon()
    hl.exec_cmd(cliphistDaemon)
end

hl.on("config.reloaded", startCliphistDaemon)

hl.on("hyprland.start", function()
{{- if eq .hyprland_features "quickshell" }}
    hl.exec_cmd("caelestia shell -d")
{{- else }}
    hl.exec_cmd("mako")
    hl.exec_cmd("waybar")
{{- end }}
    hl.exec_cmd("set-wallpaper")
    hl.exec_cmd("dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=Hyprland")
    startCliphistDaemon()
    if clipse ~= "" then
        hl.exec_cmd(clipse .. " -listen")
    end
{{- if ne $solaar "" }}
    hl.exec_cmd("solaar -w hide")
{{- end }}
{{- if ne $kded6 "" }}
    hl.exec_cmd("kded6")
{{- end }}
{{- if ne $kdeconnectIndicator "" }}
    hl.exec_cmd("kdeconnect-indicator")
{{- end }}
{{- if and (ne .hyprland_features "quickshell") (ne .swayidleLocation "") }}
    hl.exec_cmd([=[{{.swayidleLocation}} timeout 300 'swaylock -f -c 000000']=])
{{- end }}
{{- if ne $nmApplet "" }}
    hl.exec_cmd("nm-applet")
{{- end }}
end)