-- workspace_swipe was removed in Hyprland 0.55; this matches its old default
-- three-finger horizontal workspace swipe.
hl.gesture({
    fingers = 3,
    direction = "horizontal",
    action = "workspace",
})

-- ------------------------
-- Keybindings
-- ------------------------
local function registerBinds()
{{- if eq .hyprland_features "quickshell" }}
    -- Quickshell / Caelestia keybinds.
    -- Hyprland >= 0.55.3 changed catchall dispatch ordering. A release bind
    -- plus no keyboard catchall keeps the Super-only launcher usable.
    hl.bind("SUPER + SUPER_L", hl.dsp.global("caelestia:launcher"), { release = true })
    hl.bind("SUPER + mouse:272", hl.dsp.global("caelestia:launcherInterrupt"), { ignore_mods = true, non_consuming = true })
    hl.bind("SUPER + mouse:273", hl.dsp.global("caelestia:launcherInterrupt"), { ignore_mods = true, non_consuming = true })
    hl.bind("SUPER + mouse:274", hl.dsp.global("caelestia:launcherInterrupt"), { ignore_mods = true, non_consuming = true })
    hl.bind("SUPER + mouse:275", hl.dsp.global("caelestia:launcherInterrupt"), { ignore_mods = true, non_consuming = true })
    hl.bind("SUPER + mouse:276", hl.dsp.global("caelestia:launcherInterrupt"), { ignore_mods = true, non_consuming = true })
    hl.bind("SUPER + mouse:277", hl.dsp.global("caelestia:launcherInterrupt"), { ignore_mods = true, non_consuming = true })
    hl.bind("SUPER + mouse_up", hl.dsp.global("caelestia:launcherInterrupt"), { ignore_mods = true, non_consuming = true })
    hl.bind("SUPER + mouse_down", hl.dsp.global("caelestia:launcherInterrupt"), { ignore_mods = true, non_consuming = true })

    hl.bind("CTRL + ALT + Delete", hl.dsp.global("caelestia:session"))
    hl.bind("CTRL + ALT + C", hl.dsp.global("caelestia:clearNotifs"), { locked = true })
    hl.bind("SUPER + K", hl.dsp.global("caelestia:showall"))
    hl.bind("SUPER + L", hl.dsp.global("caelestia:lock"))

    hl.bind("SUPER + ALT + L", hl.dsp.exec_cmd("caelestia shell -d"), { locked = true })
    hl.bind("SUPER + ALT + L", hl.dsp.global("caelestia:lock"), { locked = true })

    hl.bind("XF86MonBrightnessUp", hl.dsp.global("caelestia:brightnessUp"), { locked = true })
    hl.bind("XF86MonBrightnessDown", hl.dsp.global("caelestia:brightnessDown"), { locked = true })

    hl.bind("CTRL + SUPER + Space", hl.dsp.global("caelestia:mediaToggle"), { locked = true })
    hl.bind("XF86AudioPlay", hl.dsp.global("caelestia:mediaToggle"), { locked = true })
    hl.bind("XF86AudioPause", hl.dsp.global("caelestia:mediaToggle"), { locked = true })
    hl.bind("CTRL + SUPER + Equal", hl.dsp.global("caelestia:mediaNext"), { locked = true })
    hl.bind("XF86AudioNext", hl.dsp.global("caelestia:mediaNext"), { locked = true })
    hl.bind("CTRL + SUPER + Minus", hl.dsp.global("caelestia:mediaPrev"), { locked = true })
    hl.bind("XF86AudioPrev", hl.dsp.global("caelestia:mediaPrev"), { locked = true })
    hl.bind("XF86AudioStop", hl.dsp.global("caelestia:mediaStop"), { locked = true })

    hl.bind("CTRL + SUPER + SHIFT + R", hl.dsp.exec_cmd("qs -c caelestia kill"), { release = true })
    hl.bind("CTRL + SUPER + ALT + R", hl.dsp.exec_cmd("qs -c caelestia kill; caelestia shell -d"), { release = true })
{{- end }}

    -- Terminal launch.
    if terminal ~= "" then
        hl.bind("CTRL + SUPER + T", hl.dsp.exec_cmd(terminal))
        hl.bind("SUPER + Return", hl.dsp.exec_cmd(terminal))
        hl.bind("CTRL + Return", hl.dsp.exec_cmd(terminal, { float = true }))
    end

    hl.bind("SUPER + Y", hl.dsp.exec_cmd("hypr-cycle-layout"))
    if launcher ~= "" then
        hl.bind("SUPER + Space", hl.dsp.exec_cmd(launcher))
    end

    if popupTerm ~= "" and clipse ~= "" then
        hl.bind("SUPER + V", hl.dsp.exec_cmd(popupTerm .. " -e " .. string.format("%q", clipse), { float = true }))
    end

    -- Windows.
    hl.bind("SUPER + SHIFT + Q", hl.dsp.window.close())
    hl.bind("SUPER + SHIFT + W", hl.dsp.window.close())
    hl.bind("SUPER + F", hl.dsp.window.fullscreen())

    hl.bind("SUPER + 0", hl.dsp.focus({ workspace = "empty" }))
    for i = 1, 9 do
        hl.bind("SUPER + " .. i, hl.dsp.focus({ workspace = i }))
    end

    hl.bind("SUPER + M", hl.dsp.workspace.toggle_special("music"))
    hl.bind("SUPER + grave", hl.dsp.workspace.toggle_special("terminal"))
    hl.bind("SUPER + T", hl.dsp.workspace.toggle_special("terminal"))
    hl.bind("SUPER + D", hl.dsp.workspace.toggle_special("scratchpad"))
    hl.bind("SUPER + P", hl.dsp.workspace.toggle_special("anytype"))

    hl.bind("SUPER + CTRL + Left", hl.dsp.focus({ workspace = "-1" }))
    hl.bind("SUPER + CTRL + Right", hl.dsp.focus({ workspace = "+1" }))
    hl.bind("SUPER + SHIFT + CTRL + Left", hl.dsp.window.move({ workspace = "-1" }))
    hl.bind("SUPER + SHIFT + CTRL + Right", hl.dsp.window.move({ workspace = "+1" }))

    hl.bind("SUPER + SHIFT + 0", hl.dsp.window.move({ workspace = "empty" }))
    for i = 1, 9 do
        hl.bind("SUPER + SHIFT + " .. i, hl.dsp.window.move({ workspace = i }))
    end

    hl.bind("ALT + Tab", function()
        hl.dispatch(hl.dsp.window.cycle_next())
        hl.dispatch(hl.dsp.window.alter_zorder({ mode = "top" }))
    end)
    hl.bind("SUPER + SHIFT + Tab", hl.dsp.window.cycle_next({ next = false }))

    -- Screen recording.
{{- if and (ne .wfRecorderLocation "") (ne .slurpLocation "") }}
    hl.bind("SUPER + SHIFT + R", hl.dsp.exec_cmd([=[{{.wfRecorderLocation}} -g "$(slurp)"]=]))
    hl.bind("SUPER + ALT + R", hl.dsp.exec_cmd([=[{{.wfRecorderLocation}}]=]))
    hl.bind("SUPER + CTRL + R", hl.dsp.exec_cmd([=[{{.wfRecorderLocation}} -g "$(slurp -w)"]=]))
{{- end }}

    -- Screenshots.
{{- if and (ne .grimLocation "") (ne .slurpLocation "") (ne .wlCopyLocation "") (ne .hyprpickerLocation "") }}
  {{- if ne .hyprshotLocation "" }}
    hl.bind("SUPER + Print", hl.dsp.exec_cmd([=[hyprshot -m window -o "$HOME/Pictures/Screenshots"]=]))
    hl.bind("SHIFT + Print", hl.dsp.exec_cmd([=[hyprshot -m screen -o "$HOME/Pictures/Screenshots"]=]))
    hl.bind("SUPER + SHIFT + Print", hl.dsp.exec_cmd([=[hyprshot -m region -o "$HOME/Pictures/Screenshots"]=]))
    hl.bind("SUPER + CTRL + Print", hl.dsp.exec_cmd([=[hyprshot -m window -o "$HOME/Pictures/Screenshots"]=]))
  {{- else }}
    hl.bind("SUPER + Print", hl.dsp.exec_cmd([=[grim -g "$(slurp -w)" - | tee "$HOME/Pictures/Screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png" | wl-copy]=]))
    hl.bind("SHIFT + Print", hl.dsp.exec_cmd([=[grim - | tee "$HOME/Pictures/Screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png" | wl-copy]=]))
    hl.bind("SUPER + SHIFT + Print", hl.dsp.exec_cmd([=[grim -g "$(slurp)" - | tee "$HOME/Pictures/Screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png" | wl-copy]=]))
    hl.bind("SUPER + CTRL + Print", hl.dsp.exec_cmd([=[grim -g "$(slurp -w)" - | tee "$HOME/Pictures/Screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png" | wl-copy]=]))
  {{- end }}
{{- end }}

    hl.bind("SUPER + F5", hl.dsp.exec_cmd("set-wallpaper"))

{{- if ne .hyprland_features "quickshell" }}
    if lockcmd ~= "" then
        hl.bind("SUPER + L", hl.dsp.exec_cmd(lockcmd))
    end
{{- end }}

    -- Media keys.
    hl.bind("XF86AudioRaiseVolume", hl.dsp.exec_cmd("wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 1%+"), { repeating = true })
    hl.bind("XF86AudioLowerVolume", hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-"), { locked = true })
    hl.bind("XF86AudioMute", hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"), { locked = true })
    hl.bind("XF86AudioPlay", hl.dsp.exec_cmd("playerctl --player=" .. playerctlPlayer .. " play-pause"), { locked = true })
    hl.bind("XF86AudioPrev", hl.dsp.exec_cmd("playerctl --player=" .. playerctlPlayer .. " previous"), { locked = true })
    hl.bind("XF86AudioNext", hl.dsp.exec_cmd("playerctl --player=" .. playerctlPlayer .. " next"), { locked = true })

    -- Mouse bindings.
    hl.bind("ALT + mouse:272", hl.dsp.window.drag(), { mouse = true })
    hl.bind("ALT + mouse:273", hl.dsp.window.resize(), { mouse = true })
end

registerBinds()

-- ------------------------
-- Workspace rules
-- ------------------------
for _, workspace in ipairs({
    "special:music",
    "special:terminal",
    "special:anytype",
    "special:scratchpad",
    "1", "2", "3", "4", "5", "6", "7", "8", "9",
}) do
    hl.workspace_rule({ workspace = workspace, persistent = true })
end

-- ------------------------
-- Window rules
-- ------------------------
hl.window_rule({
    match = { class = "^(Spotify|spotify|org.spotify.Client|com.spotify.Client)$" },
    workspace = "special:music",
})
hl.window_rule({
    match = { class = "^(Alacritty|foot|kitty|com.mitchellh.ghostty|ghostty|org.wezfurlong.wezterm|wezterm|terminator|konsole|xfce4-terminal|mate-terminal|lxterminal|URxvt|XTerm)$" },
    workspace = "special:terminal",
})
hl.window_rule({
    match = { class = "^(Anytype)$" },
    workspace = "special:anytype",
})
hl.window_rule({
    match = { class = "^(zenity|kdialog)$" },
    center = true,
})

-- ------------------------
-- Autostart
-- ------------------------
hl.on("hyprland.start", function()
{{- if eq .hyprland_features "quickshell" }}
    hl.exec_cmd("caelestia shell -d")
{{- else }}
    hl.exec_cmd("mako")
    hl.exec_cmd("waybar")
{{- end }}
    hl.exec_cmd("set-wallpaper")
    hl.exec_cmd("dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=Hyprland")
    if clipse ~= "" then
        hl.exec_cmd(clipse .. " -listen")
    end
{{- if ne $solaar "" }}
    hl.exec_cmd("solaar -w hide")
{{- end }}
{{- if ne $kded6 "" }}
    hl.exec_cmd("kded6")
{{- end }}
{{- if ne $kdeconnectIndicator "" }}
    hl.exec_cmd("kdeconnect-indicator")
{{- end }}
{{- if ne .swayidleLocation "" }}
    hl.exec_cmd([=[{{.swayidleLocation}} timeout 300 'swaylock -f -c 000000']=])
{{- end }}
{{- if ne $nmApplet "" }}
    hl.exec_cmd("nm-applet")
{{- end }}
    if terminal ~= "" then
        hl.exec_cmd(terminal, { workspace = "special:terminal silent" })
    end
end)
