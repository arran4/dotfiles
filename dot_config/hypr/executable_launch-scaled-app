#!/bin/sh
set -eu

if [ "$#" -lt 1 ]; then
    echo "usage: $0 <kjules|kmagmux> [args...]" >&2
    exit 64
fi

app=$1
shift

case "$app" in
    kjules)
        scale=${KJULES_QT_SCALE_FACTOR:-1.25}
        ;;
    kmagmux)
        scale=${KMAGMUX_QT_SCALE_FACTOR:-1.25}
        ;;
    *)
        echo "$0: unsupported application: $app" >&2
        exit 64
        ;;
esac

if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    exec env QT_SCALE_FACTOR="$scale" "$app" "$@"
fi

exec "$app" "$@"
