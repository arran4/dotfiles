# Managed by chezmoi.
# Prefer compatibility for remote systems while keeping Foot's native
# Wayland rendering and the terminal conventions used elsewhere here.

[main]
term=xterm-256color
font=JetBrains Mono:size=11,Hack:size=11,Go Mono:size=11,B612 Mono:size=11,DejaVu Sans Mono:size=11,Liberation Mono:size=11,monospace:size=11
pad=6x6
selection-target=clipboard

[scrollback]
lines=65535

[url]
launch=xdg-open ${url}

[colors-dark]
background=05070a
foreground=f0f6fc
cursor=05070a ffffff
regular0=0d1117
regular1=ff5f56
regular2=63e67a
regular3=f5c451
regular4=4da3ff
regular5=c678dd
regular6=45d4dc
regular7=d8dee9
bright0=6e7681
bright1=ff7b72
bright2=7ee787
bright3=ffd866
bright4=79c0ff
bright5=d2a8ff
bright6=7de3ea
bright7=ffffff
urls=79c0ff

[key-bindings]
clipboard-copy=Control+Insert Control+Shift+c XF86Copy
clipboard-paste=Shift+Insert Control+Shift+v XF86Paste
primary-paste=none
fullscreen=F11
