#!/bin/sh

# Reconnect Wi-Fi after any system resume, regardless of whether suspend was
# initiated by Caelestia, a lid event, or another system component.

case "$(hostname 2>/dev/null || true)" in
    x1linux|x1laptop)
        ;;
    *)
        exit 0
        ;;
esac

command -v gdbus >/dev/null 2>&1 || exit 0

exec gdbus monitor --system \
    --dest org.freedesktop.login1 \
    --object-path /org/freedesktop/login1 |
while IFS= read -r line; do
    case "$line" in
        *"PrepareForSleep (false,"*)
            # Give NetworkManager and the wireless device a moment to settle.
            sleep 2
            caelestia-wifi-reconnect || true
            ;;
    esac
done
