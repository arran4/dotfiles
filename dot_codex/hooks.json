{
  "description": "Notify when Codex needs user attention or completes a turn.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^request_user_input$",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/libexec/codex-notify question",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/libexec/codex-notify approval",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/libexec/codex-notify complete",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  }
}
