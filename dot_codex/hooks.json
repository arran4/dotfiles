{
  "description": "Notify when Codex is waiting for user approval.",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/codex-notify",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  }
}
