#!/bin/bash
##############################################################################
# slackpm
# -----------
# Send a private message to someone on slack
#
# Usage:
#   slackpm [user] [message]
#
# :authors: Jess Frazelle, @jessfraz
# :date: 8 June 2015
# :version: 0.0.1
##############################################################################
set -e
set -o pipefail

# Print a usage message and exit.
usage(){
  local name
  name=$(basename "$0")

  cat >&2 <<EOF
${name} [user] [message]

You will also need to set \$SLACK_TOKEN for authentication,
or provide it in a secure local file at ~/.config/slackpm/token (must be chmod 600).
You can generate a Web Api Token here: https://api.slack.com/web
EOF
  exit 1
}


# If SLACK_TOKEN is not provided in environment, fallback to a local token file
token_file="${HOME}/.config/slackpm/token"

if [ -z "$SLACK_TOKEN" ]; then
  if [ -e "$token_file" ] || [ -h "$token_file" ]; then
    if [ -h "$token_file" ]; then
      echo "Error: Token file $token_file cannot be a symlink." >&2
      exit 1
    fi
    if [ ! -f "$token_file" ]; then
      echo "Error: Token file $token_file must be a regular file." >&2
      exit 1
    fi
    # Check ownership (must be current user)
    owner=$(stat -c "%U" "$token_file" 2>/dev/null || stat -f "%Su" "$token_file" 2>/dev/null || echo "")
    if [ "$owner" != "$(id -un)" ]; then
      echo "Error: Token file $token_file must be owned by you (current user)." >&2
      exit 1
    fi
    # Check permissions (must be 600 or 400)
    perms=$(stat -c "%a" "$token_file" 2>/dev/null || stat -f "%Lp" "$token_file" 2>/dev/null || echo "")
    # Strip leading zero if BSD prints e.g. 0600
    perms=$(echo "$perms" | sed 's/^0*//')
    if [ "$perms" != "600" ] && [ "$perms" != "400" ]; then
      echo "Error: Token file $token_file has insecure permissions (expected 600 or 400)." >&2
      echo "Run 'chmod 600 $token_file' to secure it." >&2
      exit 1
    fi
    # Validate token contents (reject whitespace, extra lines, control chars)
    if ! SLACK_TOKEN=$(awk 'NR==1{sub(/\r$/,""); print $0; found=1} NR>1{err=1; exit 1} END{if(!found || err) exit 1}' "$token_file" 2>/dev/null); then
      echo "Error: Token file $token_file is unreadable, empty, or contains multiple lines." >&2
      exit 1
    fi
    if ! printf "%s" "$SLACK_TOKEN" | grep -qxE "[A-Za-z0-9_.-]+"; then
      echo "Error: Token file $token_file contains invalid characters or whitespace." >&2
      exit 1
    fi
  fi
fi

[ "$SLACK_TOKEN" ] || usage


# Print usage with --help or -h
if [ "$#" -lt 2 ]; then
  usage;
fi

nick_to_userid(){
  local nick=$1

  # get the users
  local response
  # Use printf builtin to avoid argv exposure, and -H @- to feed headers via stdin
  response=$(printf "Authorization: Bearer %s" "${SLACK_TOKEN}" | curl -sS -X POST \
    -H @- \
    https://slack.com/api/users.list)

  if [[ $(echo "$response" | jq -r '.ok') != "true" ]]; then
    echo "Failed to fetch users list: $(echo "$response" | jq -r '.error')"
    return 1
  fi

  local users
  users=$(echo "$response" | jq '.members')

  # find the user we want safely using --arg to prevent jq injection
  local user
  user=$(echo "$users" | jq --arg nick "$nick" '.[]? | select(.name == $nick)')

  if [[ -z "$user" || "$user" == "null" ]]; then
    echo "Could not find user with nick ${nick}."
    return 1
  fi

  # set userid
  userid=$(echo "$user" | jq --raw-output '.id')

  echo "Sending private message to:"
  echo "  User:    ${nick}"
}

user_to_channelid(){
  local user=$1

  # Open a DM channel with the user using the Conversations API
  local response
  response=$(printf "Authorization: Bearer %s" "${SLACK_TOKEN}" | curl -sS -X POST \
    -H @- \
    --data-urlencode "users=${user}" \
    https://slack.com/api/conversations.open)

  if [[ $(echo "$response" | jq -r '.ok') != "true" ]]; then
    echo "Could not open IM channel with user ID ${user}: $(echo "$response" | jq -r '.error')"
    return 1
  fi

  # set channelid
  channelid=$(echo "$response" | jq --raw-output '.channel.id')
}

send_message(){
  local userid channelid
  local nick=$1
  local message="${*:2}"

  # get the users id
  nick_to_userid "${nick}"

  # get the channel id for the im with this user
  user_to_channelid "${userid}"

  local postresp
  postresp=$(printf "Authorization: Bearer %s" "${SLACK_TOKEN}" | curl -sS -X POST \
    -H @- \
    --data-urlencode "channel=${channelid}" \
    --data-urlencode "text=${message}" \
    --data-urlencode "as_user=1" \
    https://slack.com/api/chat.postMessage)

  if [[ $(echo "$postresp" | jq -r '.ok') != "true" ]]; then
    echo "Failed to send message: $(echo "$postresp" | jq -r '.error')"
    return 1
  fi

  echo "$postresp" | jq .
}

send_message "$@"
