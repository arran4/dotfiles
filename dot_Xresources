! Prefer modern scalable monospace fonts when Xft/fontconfig support is available.
! Missing Xft families are skipped; the final core font keeps urxvt usable without Xft.
URxvt*font: xft:JetBrains Mono:size=11,\
            xft:Hack:size=11,\
            xft:Go Mono:size=11,\
            xft:B612 Mono:size=11,\
            xft:DejaVu Sans Mono:size=11,\
            xft:Liberation Mono:size=11,\
            xft:monospace:size=11,\
            fixed
! urxvt can overestimate Xft cell width for some monospace fonts; tighten it slightly.
URxvt*letterSpace: -1

! Keep urxvt usable as a fallback with native ARGB transparency.
URxvt.depth: 32
URxvt*background: [90]#002b36
URxvt*foreground: #839496

URxvt*saveLines: 65535
URxvt.secondaryScroll: False
URxvt*scrollstyle: plain

! Perl extensions: eval provides the clipboard actions; matcher handles clickable URLs.
! tabbed is bundled with rxvt-unicode; fullscreen is managed in ~/.urxvt/ext/fullscreen.
URxvt.perl-ext-common: default,eval,matcher,tabbed,fullscreen
URxvt.url-launcher: /usr/bin/xdg-open
URxvt.matcher.launcher: /usr/bin/xdg-open
URxvt.matcher.button: 1
URxvt.keysym.Control-Insert: eval:selection_to_clipboard
URxvt.keysym.Shift-Insert: eval:paste_clipboard
URxvt.keysym.F11: perl:fullscreen:switch

Rxvt*reverseVideo: True
Rxvt*saveLines: 65535

! xterm is the preferred X terminal. Hyprland supplies window transparency so
! the X resource colors can stay high-contrast and readable.
XTerm*faceName: JetBrains Mono,Hack,Go Mono,B612 Mono,DejaVu Sans Mono,Liberation Mono,monospace
XTerm*faceSize: 11
XTerm*renderFont: true
XTerm*font: fixed
XTerm*background: #002b36
XTerm*foreground: #eee8d5
XTerm*cursorColor: #93a1a1
XTerm*selectToClipboard: true
XTerm*saveLines: 65535

! Preserve the clipboard and fullscreen shortcuts used by the urxvt setup.
XTerm*VT100.translations: #override \
    Ctrl <Key>Insert: copy-selection(CLIPBOARD) \n\
    Shift <Key>Insert: insert-selection(CLIPBOARD) \n\
    <Key>F11: fullscreen(toggle)
