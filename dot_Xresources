! Prefer modern scalable monospace fonts when Xft/fontconfig support is available.
! Missing Xft families are skipped; the final core font keeps urxvt usable without Xft.
URxvt*font: xft:JetBrains Mono:size=10,\
            xft:Hack:size=10,\
            xft:Go Mono:size=10,\
            xft:B612 Mono:size=10,\
            xft:DejaVu Sans Mono:size=10,\
            xft:Liberation Mono:size=10,\
            xft:monospace:size=10,\
            fixed
URxvt*reverseVideo: True
URxvt*saveLines: 65535

Rxvt*reverseVideo: True
Rxvt*saveLines: 65535

! xterm uses faceName when built with FreeType/Xft and falls back to the core font otherwise.
XTerm*faceName: JetBrains Mono,Hack,Go Mono,B612 Mono,DejaVu Sans Mono,Liberation Mono,monospace
XTerm*faceSize: 10
XTerm*font: fixed
XTerm*reverseVideo: True
XTerm*saveLines: 65535
